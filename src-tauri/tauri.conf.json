{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "RHODIZ Harness Desktop",
  "version": "0.1.0",
  "identifier": "com.rhodiz.harness.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 1420",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "RHODIZ Harness Desktop",
      "width": 1280,
      "height": 800,
      "minWidth": 960,
      "minHeight": 640,
      "devtools": false
    }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
