{
  "name": "@rhodiz/harness-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:tokens": "node scripts/build-tokens.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml -p rhodiz-harness-broker-core",
    "fmt:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "clippy:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml -p rhodiz-harness-broker-core --all-targets -- -D warnings",
    "check:tauri": "cargo check --manifest-path src-tauri/Cargo.toml --tests",
    "clippy:tauri": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "tauri": "tauri",
    "verify": "npm run verify:portable",
    "verify:portable": "npm run lint && npm run test:coverage && npm run build && npm run fmt:rust && npm run test:rust && npm run clippy:rust",
    "verify:windows": "npm run verify:portable && npm run check:tauri && npm run clippy:tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "jsdom": "30.1.0",
    "oxlint": "1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
